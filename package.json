{
	"name": "vikala",
	"version": "1.0.2",
	"description": "Custom tailored Discord bot using the Sapphire Framework (OOD)",
	"main": "src/bot.js",
	"author": "4miau",
	"license": "Apache-2.0",
	"dependencies": {
		"@dotenvx/dotenvx": "^1.75.1",
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/framework": "^5.5.0",
		"@sapphire/plugin-editable-commands": "^4.0.4",
		"@sapphire/plugin-subcommands": "^7.0.1",
		"@sapphire/utilities": "^3.18.2",
		"axios": "^1.18.1",
		"cheerio": "^1.2.0",
		"chrono-node": "^2.9.1",
		"discord.js": "^14.26.4",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"glob": "^13.0.6",
		"google-auth-library": "^10.9.0",
		"google-spreadsheet": "^5.3.0",
		"miau-utilities": "^0.0.2",
		"mongoose": "^9.7.2",
		"ms": "^2.1.3",
		"node-emoji": "^2.2.0"
	},
	"scripts": {
		"dev": "bun src/bot.ts",
		"build": "tsc",
		"start": "node dist/bot.js",
		"watch": "node --watch dist/bot.js",
		"lint": "bunx @biomejs/biome lint .",
		"lint:fix": "bunx @biomejs/biome lint --write .",
		"format": "bunx @biomejs/biome format .",
		"format:fix": "bunx @biomejs/biome format --write .",
		"check": "bunx @biomejs/biome check .",
		"check:fix": "bunx @biomejs/biome check --write .",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f vikala",
		"docker:restart": "docker compose restart vikala",
		"docker:dev": "docker compose --profile dev up vikala-dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/cheerio": "^1.0.0",
		"@types/express": "^5.0.6",
		"@types/ms": "^2.1.0",
		"@types/node-emoji": "^2.1.0",
		"typescript": "^6.0.3"
	}
}
